# Memory Gateway 环境变量
# 复制为 .env 后修改

# API Key（生产环境必须设置！留空则不启用认证）
MEMORY_API_KEY=change-me-to-a-random-string

# 数据目录（容器内路径，通常不需要改）
MEMORY_DATA_DIR=/data

# 端口
MEMORY_PORT=8650

# 日志级别: DEBUG, INFO, WARNING, ERROR
MEMORY_LOG_LEVEL=INFO

# ── LLM 配置（知识图谱关键字提取）──────────────────────
# 用于知识图谱关键字提取，提高提取准确性
# 支持: openai, claude
# 留空则使用 jieba 分词（无需 API Key）

# LLM 提供商: openai 或 claude
# MEMORY_LLM_PROVIDER=openai

# LLM API Key
# MEMORY_LLM_API_KEY=sk-xxx

# LLM API Base URL（可选，用于自定义端点）
# MEMORY_LLM_BASE_URL=https://api.openai.com/v1

# LLM 模型（可选，使用默认模型）
# OpenAI 默认: gpt-3.5-turbo
# Claude 默认: claude-3-haiku-20240307
# MEMORY_LLM_MODEL=gpt-3.5-turbo

# LLM 超时时间（秒）
# MEMORY_LLM_TIMEOUT=10

# ── CORS 配置 ──────────────────────────────────────────
# 允许的来源（逗号分隔）
# 留空使用默认值（localhost:8650, localhost:3000 等）
# MEMORY_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:8650

# ── 热缓存配置 ────────────────────────────────────────
# 热缓存最大条目数
# MEMORY_HOT_CACHE_SIZE=200

# 热缓存 TTL（秒）
# MEMORY_HOT_CACHE_TTL=300

# ── 登录安全配置 ──────────────────────────────────────
# 最大登录失败次数
# MEMORY_MAX_LOGIN_FAILURES=5

# 锁定时间（秒）
# MEMORY_LOCKOUT_DURATION=1800

# 会话有效期（秒，默认7天）
# MEMORY_SESSION_DURATION=604800
